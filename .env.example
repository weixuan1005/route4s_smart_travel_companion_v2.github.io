# Copy this file to .env and fill in your own values. Never commit .env.

# LTA DataMall AccountKey (free): https://datamall.lta.gov.sg
# Enables live train alerts, station crowding, bus arrivals and bike parking.
LTA_ACCOUNT_KEY=

# Optional data.gov.sg API key. The 2-hour forecast endpoint we use is open and answered
# identically with and without a key when we checked, so leaving this blank costs nothing.
DATAGOV_API_KEY=

# OSRM street routing started by `docker compose up` (see README)
OSRM_FOOT_URL=http://localhost:5001
OSRM_BIKE_URL=http://localhost:5002

# Optional OneMap token, only if OneMap search starts asking for one
ONEMAP_TOKEN=
